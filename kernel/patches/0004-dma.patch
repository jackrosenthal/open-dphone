+/*
+ * Some integrations do not combine the interrupt outputs of the controller
+ * but route one line per channel to the interrupt controller. The handler
+ * above only looks at the controller-wide status, so it serves any number of
+ * lines.
+ */
+static int dw_dma_irq_line(struct dw_dma_chip *chip, unsigned int i)
+{
+	return chip->nr_irqs ? chip->irqs[i] : chip->irq;
+}
+
+static void dw_dma_free_irqs(struct dw_dma_chip *chip, unsigned int nr)
+{
+	while (nr--)
+		free_irq(dw_dma_irq_line(chip, nr), chip->dw);
+}
+
+static int dw_dma_request_irqs(struct dw_dma_chip *chip)
+{
+	unsigned int nr = chip->nr_irqs ?: 1;
+	struct dw_dma *dw = chip->dw;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < nr; i++) {
+		ret = request_irq(dw_dma_irq_line(chip, i), dw_dma_interrupt,
+				  IRQF_SHARED, dw->name, dw);
+		if (ret) {
+			dw_dma_free_irqs(chip, i);
+			return ret;
+		}
+	}
+
+	return 0;
+}
