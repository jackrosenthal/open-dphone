+static struct dma_async_tx_descriptor *
+dwc_prep_dma_cyclic(struct dma_chan *chan, dma_addr_t buf_addr, size_t buf_len,
+		    size_t period_len, enum dma_transfer_direction direction,
+		    unsigned long flags)
+{
+	struct dw_dma_chan	*dwc = to_dw_dma_chan(chan);
+	struct dw_dma		*dw = to_dw_dma(chan->device);
+	struct dma_slave_config	*sconfig = &dwc->dma_sconfig;
+	struct dw_desc		*prev = NULL;
+	struct dw_desc		*first = NULL;
+	u32			ctllo;
+	u8			lms = DWC_LLP_LMS(dwc->dws.m_master);
+	dma_addr_t		reg;
+	unsigned int		reg_width;
+	unsigned int		mem_width;
+	size_t			offset;
+
+	if (unlikely(!is_slave_direction(direction) || !buf_len || !period_len))
+		return NULL;
+
+	if (unlikely(buf_len % period_len))
+		return NULL;
+
+	/*
+	 * The hardware has to walk the ring of blocks on its own; restarting
+	 * the channel from the interrupt handler for every block would leave
+	 * gaps in the stream.
+	 */
+	if (dwc->nollp) {
+		dev_dbg(chan2dev(chan),
+			"cyclic transfers need multi block support\n");
+		return NULL;
+	}
+
+	dwc->direction = direction;
+
+	switch (direction) {
+	case DMA_MEM_TO_DEV:
+		reg_width = __ffs(sconfig->dst_addr_width);
+		reg = sconfig->dst_addr;
+		mem_width = __ffs(sconfig->src_addr_width | buf_addr | period_len);
+		ctllo = dw->prepare_ctllo(dwc)
+				| DWC_CTLL_DST_WIDTH(reg_width)
+				| DWC_CTLL_SRC_WIDTH(mem_width)
+				| DWC_CTLL_DST_FIX
+				| DWC_CTLL_SRC_INC;
+
+		ctllo |= sconfig->device_fc ? DWC_CTLL_FC(DW_DMA_FC_P_M2P) :
+			DWC_CTLL_FC(DW_DMA_FC_D_M2P);
+		break;
+	case DMA_DEV_TO_MEM:
+		reg_width = __ffs(sconfig->src_addr_width);
+		reg = sconfig->src_addr;
+		mem_width = __ffs(sconfig->dst_addr_width | buf_addr | period_len);
+
+		/* The block size is counted in units of the source width */
+		if (period_len & (BIT(reg_width) - 1))
+			return NULL;
+
+		ctllo = dw->prepare_ctllo(dwc)
+				| DWC_CTLL_SRC_WIDTH(reg_width)
+				| DWC_CTLL_DST_WIDTH(mem_width)
+				| DWC_CTLL_DST_INC
+				| DWC_CTLL_SRC_FIX;
+
+		ctllo |= sconfig->device_fc ? DWC_CTLL_FC(DW_DMA_FC_P_P2M) :
+			DWC_CTLL_FC(DW_DMA_FC_D_P2M);
+		break;
+	default:
+		return NULL;
+	}
+
+	for (offset = 0; offset < buf_len; offset += period_len) {
+		dma_addr_t	mem = buf_addr + offset;
+		size_t		len = period_len;
+
+		/* A period takes more than one block if it exceeds the block size */
+		while (len) {
+			struct dw_desc	*desc;
+			size_t		dlen;
+			u32		ctlhi;
+
+			desc = dwc_desc_get(dwc);
+			if (!desc)
+				goto err_desc_get;
+
+			if (direction == DMA_MEM_TO_DEV) {
+				ctlhi = dw->bytes2block(dwc, len, mem_width, &dlen);
+				lli_write(desc, sar, mem);
+				lli_write(desc, dar, reg);
+			} else {
+				ctlhi = dw->bytes2block(dwc, len, reg_width, &dlen);
+				lli_write(desc, sar, reg);
+				lli_write(desc, dar, mem);
+			}
+			lli_write(desc, ctlhi, ctlhi);
+			lli_write(desc, ctllo, ctllo);
+			desc->len = dlen;
+
+			if (!first) {
+				first = desc;
+			} else {
+				lli_write(prev, llp, desc->txd.phys | lms);
+				list_add_tail(&desc->desc_node, &first->tx_list);
+			}
+			prev = desc;
+
+			mem += dlen;
+			len -= dlen;
+		}
+
+		if (flags & DMA_PREP_INTERRUPT)
+			/* Trigger interrupt after the last block of each period */
+			lli_set(prev, ctllo, DWC_CTLL_INT_EN);
+	}
+
+	/* Close the ring; every block keeps the block chaining enabled */
+	lli_write(prev, llp, first->txd.phys | lms);
+
+	first->txd.flags = flags;
+	first->total_len = buf_len;
+	first->residue = buf_len;
+	first->cyclic = true;
+
+	return &first->txd;
+
+err_desc_get:
+	dev_err(chan2dev(chan),
+		"not enough descriptors available. Direction %d\n", direction);
+	dwc_desc_put(dwc, first);
+	return NULL;
+}
