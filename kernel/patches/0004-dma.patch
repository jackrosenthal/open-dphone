+/*
+ * Bytes left until the end of the buffer of a running cyclic transfer.
+ * Called with dwc->lock held.
+ */
+static u32 dwc_get_cyclic_residue(struct dw_dma_chan *dwc, struct dw_desc *desc)
+{
+	unsigned int retries = 3;
+	struct dw_desc *child;
+	u32 residue = desc->total_len;
+	u32 llp, sent;
+
+	/*
+	 * Right after the start the hardware has not fetched the first block
+	 * yet and the registers still hold what dwc_dostart() wrote. A block
+	 * of a slave transfer never has an all-zero transfer type.
+	 */
+	if (channel_readl(dwc, CTL_LO) == (DWC_CTLL_LLP_D_EN | DWC_CTLL_LLP_S_EN))
+		return residue;
+
+	/* The pair has to belong to the same block */
+	do {
+		llp = channel_readl(dwc, LLP);
+		sent = dwc_get_sent(dwc);
+	} while (llp != channel_readl(dwc, LLP) && --retries);
+
+	/* The LLP register points to the successor of the block in progress */
+	if (lli_read(desc, llp) == llp)
+		return residue - min_t(u32, sent, desc->len);
+
+	residue -= desc->len;
+	list_for_each_entry(child, &desc->tx_list, desc_node) {
+		if (lli_read(child, llp) == llp)
+			return residue - min_t(u32, sent, child->len);
+		residue -= child->len;
+	}
+
+	return desc->total_len;
+}
