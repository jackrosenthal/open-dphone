+/*
+ * Channels this driver has started a transfer on. The interrupt masks of the
+ * others are not ours to change: such a channel may be programmed by another
+ * master on the bus which relies on its interrupt staying unmasked.
+ */
+static u8 dw_dma_live_mask(struct dw_dma *dw)
+{
+	unsigned int i;
+	u8 mask = 0;
+
+	for (i = 0; i < dw->dma.chancnt; i++)
+		if (test_bit(DW_DMA_IS_INITIALIZED, &dw->chan[i].flags))
+			mask |= dw->chan[i].mask;
+
+	return mask;
 }
 
