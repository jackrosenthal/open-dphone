diff --git a/drivers/mtd/nand/raw/Kconfig b/drivers/mtd/nand/raw/Kconfig
index 1f4053e531fd88e2c25df663e82b122e0dc09bab..da3dce3c2b886f428ea7b2fd5c61865a1cff8f38 100644
--- a/drivers/mtd/nand/raw/Kconfig
+++ b/drivers/mtd/nand/raw/Kconfig
@@ -373,6 +373,16 @@ config MTD_NAND_PLATFORM
 	  devices. You will need to provide platform-specific functions
 	  via platform_data.
 
+config MTD_NAND_BCMRING
+	tristate "Broadcom BCMRING UMI NAND controller"
+	depends on ARCH_BCMRING || COMPILE_TEST
+	depends on HAS_IOMEM
+	select BCH
+	help
+	  NAND controller of the Broadcom BCMRING SoCs (vendor driver name
+	  "bcm_umi-nand").  Uses the vendor on-flash ECC format: BCH-8 over
+	  512-byte steps with 13 ECC bytes per step.
+
 config MTD_NAND_CADENCE
 	tristate "Support Cadence NAND (HPNFC) controller"
 	depends on OF && HAS_IOMEM
