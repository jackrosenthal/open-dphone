diff --git a/arch/arm/boot/compressed/head.S b/arch/arm/boot/compressed/head.S
index 9f406e9c0ea6f74bc2d8fd71a7625977de891691..49ea302ed2bd32bcc65396c08f2ad1c40145f22b 100644
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -292,7 +292,34 @@ not_angel:
 		ldr	r2, [r2]	@ get DTB signature
 		ldr	r3, =OF_DT_MAGIC
 		cmp	r2, r3		@ do we have a DTB there?
+#ifdef CONFIG_ARM_APPENDED_DTB_MEM_START
+		bne	2f
+		/* Its memory nodes are right: take the start of RAM from it. */
+		ldr	r2, [r1, #4]	@ get &_edata
+		add	r2, r2, r1	@ relocate it
+		ldr	sp, [r1]	@ get stack location
+		add	sp, sp, r1	@ apply relocation
+		/*
+		 * The appended DTB lies where the BSS and the stack will
+		 * be: use a stack above it, as the code below does.
+		 */
+		ldr	r3, [r2, #4]	@ DTB size, big endian
+#ifndef __ARMEB__
+		eor	ip, r3, r3, ror #16
+		bic	ip, ip, #0x00ff0000
+		mov	r3, r3, ror #8
+		eor	r3, r3, ip, lsr #8
+#endif
+		add	r3, r3, #7
+		bic	r3, r3, #7
+		add	sp, sp, r3
+		mov	r1, r2
+		bl	fdt_check_mem_start
+		b	1f
+2:
+#else
 		beq	1f		@ if yes, skip validation
+#endif
 #endif /* CONFIG_ARM_APPENDED_DTB */
 
 		/*
