diff --git a/drivers/net/phy/broadcom.c b/drivers/net/phy/broadcom.c
index d1a4edb34ad2efc3b7eb55fea612acef3627d3a8..99bc886335dc118d19487488d94eed5cab636c9d 100644
--- a/drivers/net/phy/broadcom.c
+++ b/drivers/net/phy/broadcom.c
@@ -1260,6 +1260,68 @@ static void bcm54xx_link_change_notify(struct phy_device *phydev)
 	bcm_phy_write_exp(phydev, MII_BCM54XX_EXP_EXP08, ret);
 }
 
+/*
+ * Gigabit PHY core integrated in the Ethernet switch of the BCMRING SoCs
+ * (BCM11107 family).  ID 0x0143bd91; the part name is not known, and the
+ * register model is that of the BCM54xx family (closest relatives: BCM50610
+ * and BCM50610M).  NEVER RUN ON HARDWARE under this driver.
+ *
+ * config_init reproduces the three fixups of the vendor kernel with the
+ * vendor's own values, and nothing else.  bcm54xx_config_init() is not used:
+ * its clock, LED, and model-specific paths are untested on this core.  The
+ * bcm-phy-lib helpers for auto power-down and downshift are not used either,
+ * because they write more than the vendor does (the single-link-pulse bit
+ * and the wirespeed retry shadow).  The auto power-down and wirespeed values
+ * were read back as written on a stock BCM11189 and a stock BCM11170; the
+ * expansion register fixup is known from the vendor code only.
+ *
+ * Registers 0x0d and 0x0e are not the Clause 45 access pair on this core
+ * (they read back zero), hence the *_mmd_unsupported callbacks: without
+ * them phylib's EEE probing would write both registers.  There is no
+ * interrupt support: the interrupt outputs end in two switch wrapper words
+ * of unknown layout that no vendor code uses.  Register 0x0f claims
+ * 1000BASE-T on the 10/100 SoCs as well, so that restriction has to come
+ * from the MAC side (the b53 BCMRING glue removes MAC_1000 there).
+ */
+#define BCMRING_GPHY_APD_WAKE_TIMER	0x0001	/* vendor sets it; name inferred */
+
+static int bcmring_gphy_config_init(struct phy_device *phydev)
+{
+	int val, ret;
+
+	/*
+	 * Vendor, gigabit SoCs only: clear bit 9 of expansion register 0x08
+	 * and leave the expansion selector at zero.  This is the BCM50610
+	 * "phy interop issue" fix.
+	 */
+	if (phydev->dev_flags & PHY_BRCM_BCMRING_GIGABIT) {
+		phy_lock_mdio_bus(phydev);
+		ret = __bcm_phy_modify_exp(phydev, MII_BCM54XX_EXP_EXP08,
+					   MII_BCM54XX_EXP_EXP08_EARLY_DAC_WAKE,
+					   0);
+		__phy_write(phydev, MII_BCM54XX_EXP_SEL, 0);
+		phy_unlock_mdio_bus(phydev);
+		if (ret < 0)
+			return ret;
+	}
+
+	/* Vendor: register 0x1c = 0xa821, auto power-down with wake timer */
+	ret = bcm_phy_write_shadow(phydev, BCM54XX_SHD_APD,
+				   BCM54XX_SHD_APD_EN |
+				   BCMRING_GPHY_APD_WAKE_TIMER);
+	if (ret < 0)
+		return ret;
+
+	/* Vendor: register 0x18 = 0x7007, read, write back | 0x8017 */
+	val = bcm54xx_auxctl_read(phydev, MII_BCM54XX_AUXCTL_SHDWSEL_MISC);
+	if (val < 0)
+		return val;
+
+	return bcm54xx_auxctl_write(phydev, MII_BCM54XX_AUXCTL_SHDWSEL_MISC,
+				    val | MII_BCM54XX_AUXCTL_MISC_WREN |
+				    MII_BCM54XX_AUXCTL_SHDWSEL_MISC_WIRESPEED_EN);
+}
+
 static int lre_read_master_slave(struct phy_device *phydev)
 {
 	int cfg = MASTER_SLAVE_CFG_UNKNOWN, state;
@@ -1749,6 +1811,16 @@ static struct phy_driver broadcom_drivers[] = {
 	.config_intr    = bcm_phy_config_intr,
 	.handle_interrupt = bcm_phy_handle_interrupt,
 	.link_change_notify	= bcm54xx_link_change_notify,
+}, {
+	PHY_ID_MATCH_MODEL(PHY_ID_BCMRING_GPHY),
+	.name		= "Broadcom BCMRING GPHY",
+	.flags		= PHY_IS_INTERNAL,
+	/* PHY_GBIT_FEATURES by auto-detection; see the comment above */
+	.config_init	= bcmring_gphy_config_init,
+	.read_mmd	= genphy_read_mmd_unsupported,
+	.write_mmd	= genphy_write_mmd_unsupported,
+	.suspend	= genphy_suspend,
+	.resume		= genphy_resume,
 } };
 
 module_phy_driver(broadcom_drivers);
@@ -1775,6 +1847,7 @@ static const struct mdio_device_id __maybe_unused broadcom_tbl[] = {
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM53125) },
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM53128) },
 	{ PHY_ID_MATCH_MODEL(PHY_ID_BCM89610) },
+	{ PHY_ID_MATCH_MODEL(PHY_ID_BCMRING_GPHY) },
 	{ }
 };
 
