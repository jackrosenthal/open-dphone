diff --git a/drivers/leds/Kconfig b/drivers/leds/Kconfig
index d0d3182236be4cc75e911f3f6c93455d99527253..28a1a6463b5c49c7f24439ef8db0a1d46761def6 100644
--- a/drivers/leds/Kconfig
+++ b/drivers/leds/Kconfig
@@ -166,6 +166,15 @@ config LEDS_BCM6358
 	  This option enables support for LEDs connected to the BCM6358
 	  LED HW controller accessed via MMIO registers.
 
+config LEDS_BCMRING_LEDM
+	tristate "LED support for the Broadcom BCMRING LED matrix controller"
+	depends on LEDS_CLASS
+	depends on ARCH_BCMRING || COMPILE_TEST
+	depends on HAS_IOMEM
+	help
+	  This option enables support for LEDs driven by the LED matrix
+	  controller of the Broadcom BCMRING SoCs (BCM11107 family).
+
 config LEDS_CHT_WCOVE
 	tristate "LED support for Intel Cherry Trail Whiskey Cove PMIC"
 	depends on LEDS_CLASS
