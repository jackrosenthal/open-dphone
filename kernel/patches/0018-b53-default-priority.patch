+/*
+ * The port default tag holds the VLAN ID given to untagged frames received
+ * on the port in bits 11:0 and their 802.1p priority in bits 15:13.
+ */
+#define B53_DEF_TAG_PRIO_SHIFT	13
+
+static void b53_write_def_tag(struct b53_device *dev, int port, u16 vid)
+{
+	b53_write16(dev, B53_VLAN_PAGE, B53_VLAN_PORT_DEF_TAG(port),
+		    vid | dev->ports[port].def_prio << B53_DEF_TAG_PRIO_SHIFT);
+}
