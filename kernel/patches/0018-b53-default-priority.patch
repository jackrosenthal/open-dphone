+/*
+ * Default 802.1p priority of untagged frames received on a port (DCB:
+ * "dcb app add dev <port> default-prio <n>").  The register also holds the
+ * port's VLAN ID, which stays as it is.
+ */
+static int b53_port_get_default_prio(struct dsa_switch *ds, int port)
+{
+	struct b53_device *dev = ds->priv;
+
+	return dev->ports[port].def_prio;
+}
+
+static int b53_port_set_default_prio(struct dsa_switch *ds, int port, u8 prio)
+{
+	struct b53_device *dev = ds->priv;
+	u16 tag;
+
+	if (prio > 7)
+		return -EINVAL;
+
+	dev->ports[port].def_prio = prio;
+	b53_read16(dev, B53_VLAN_PAGE, B53_VLAN_PORT_DEF_TAG(port), &tag);
+	b53_write_def_tag(dev, port, tag & VLAN_VID_MASK);
+
+	return 0;
+}
