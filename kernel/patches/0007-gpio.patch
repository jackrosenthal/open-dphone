diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index a48586bb8edbae8f075cc062189a4c8c27839429..0d37596e84bf4594f574d43ed1cec76edb886920 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -214,6 +214,15 @@ config GPIO_RASPBERRYPI_EXP
 	  Turn on GPIO support for the expander on Raspberry Pi 3 boards, using
 	  the firmware mailbox to communicate with VideoCore on BCM283x chips.
 
+config GPIO_BCMRING
+	tristate "Broadcom BCMRING GPIO"
+	depends on ARCH_BCMRING || COMPILE_TEST
+	depends on HAS_IOMEM
+	select GPIOLIB_IRQCHIP
+	help
+	  GPIO banks of the Broadcom BCMRING SoCs (BCM11107 family), with
+	  per-line interrupt support.
+
 config GPIO_BCM_KONA
 	bool "Broadcom Kona GPIO"
 	depends on ARCH_BCM_MOBILE || COMPILE_TEST
diff --git a/drivers/gpio/Makefile b/drivers/gpio/Makefile
index dc9e6d643b5bca5a61645a98b08b05f625c7b36b..1d77f0dd14319e8970e7fc05a9811a3ab95e0672 100644
--- a/drivers/gpio/Makefile
+++ b/drivers/gpio/Makefile
@@ -40,6 +40,7 @@ obj-$(CONFIG_GPIO_ARIZONA)		+= gpio-arizona.o
 obj-$(CONFIG_GPIO_ASPEED)		+= gpio-aspeed.o
 obj-$(CONFIG_GPIO_ASPEED_SGPIO)		+= gpio-aspeed-sgpio.o
 obj-$(CONFIG_GPIO_ATH79)		+= gpio-ath79.o
+obj-$(CONFIG_GPIO_BCMRING)		+= gpio-bcmring.o
 obj-$(CONFIG_GPIO_BCM_KONA)		+= gpio-bcm-kona.o
 obj-$(CONFIG_GPIO_BCM_XGS_IPROC)	+= gpio-xgs-iproc.o
 obj-$(CONFIG_GPIO_BD71815)		+= gpio-bd71815.o
