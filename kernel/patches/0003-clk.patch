diff --git a/drivers/clk/bcm/Kconfig b/drivers/clk/bcm/Kconfig
index a972d763eb77d9686c1c1493dc715eb368c5ec16..96a72fc8afc50f7d9821b5e0ba34c4ff9d48bacd 100644
--- a/drivers/clk/bcm/Kconfig
+++ b/drivers/clk/bcm/Kconfig
@@ -109,3 +109,16 @@ config CLK_RASPBERRYPI
 	help
 	  Enable common clock framework support for Raspberry Pi's firmware
 	  dependent clocks
+
+config COMMON_CLK_BCMRING
+	bool "Broadcom BCMRING chip-control clock and reset driver"
+	depends on ARCH_BCMRING || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	select MFD_SYSCON
+	select REGMAP_MMIO
+	select RESET_CONTROLLER
+	help
+	  Clock (PLL channels, dividers, bus-interface gates) and soft-reset
+	  controller in the chip-control block of BCMRING SoCs.  The driver
+	  also publishes the block as a syscon regmap for the few users of
+	  its miscellaneous registers.
