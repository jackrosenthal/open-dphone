        </state>
        <state id="incoming/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
