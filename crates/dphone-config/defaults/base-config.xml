    <setting id="send_mac_with_useragent" value="0"/>
    <setting id="enable_check_sync" value="1"/>
    <setting id="enable_ice" value="0"/>
    <setting id="stunaddr" value=""/>
    <setting id="default_dial_plan" value="[0-8]xx|911|9411|9611|9011xxx.T3|91xxxxxxxxxx|9[2-9]xxxxxx|*xxx.T3|+xxxxxxxxxxxxxxx"/>
    <setting id="g729_authorized" value="0"/>

    <!-- Provisioning and PBX integration -->
