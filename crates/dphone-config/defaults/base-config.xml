<?xml version="1.0" ?>
<!--
    Open DPhone model-independent defaults (merge layer 1).

    Setting IDs and value vocabularies follow the stock firmware wherever the
    meaning is the same, so that provisioned and locally saved layers written
    for either firmware merge the same way.  Settings that only Open DPhone
    knows start with "open_" and are stored in /nvdata/open/config.xml when
    changed, never in a file stock reads.

    Repeated elements need an identity attribute ("id" for most elements),
    or the merge folds them into one.
-->
<config>
    <!-- Identity; the factory layer freezes the real values. -->
    <setting id="phone_model" value="unknown"/>
    <setting id="max_accounts" value="2"/>

    <!-- Network -->
    <setting id="network_enable_dhcp" value="1"/>
    <setting id="network_static_ip_address" value=""/>
    <setting id="network_subnet_mask" value=""/>
    <setting id="network_default_gateway" value=""/>
    <setting id="network_domain_name" value=""/>
    <setting id="network_primary_dns_server" value=""/>
    <setting id="network_secondary_dns_server" value=""/>
    <setting id="network_disable_arping" value="0"/>
    <setting id="network_ipv6_enabled" value="0"/>
    <setting id="network_ipv6_preferred" value="0"/>
    <setting id="network6_static_ip_address" value=""/>
    <setting id="network6_mask" value=""/>
    <setting id="network6_default_gateway" value=""/>
    <setting id="network_vlan_discovery_mode" value="LLDP"/>
    <setting id="pc_vlan_id" value=""/>
    <setting id="pc_qos" value="1"/>
    <setting id="lan_port_mode" value="auto"/>
    <setting id="pc_port_mode" value="auto"/>
    <setting id="sip_dscp" value="26"/>
    <setting id="sip_qos" value="3"/>
    <setting id="rtp_dscp" value="46"/>
    <setting id="rtp_qos" value="6"/>
    <setting id="sip_dscp_with_lldp_override" value="-1"/>
    <setting id="rtp_dscp_with_lldp_override" value="-1"/>

    <!-- Wired 802.1X and VPN: kept so stock finds its settings; only the
         PC-port pass-through is acted on. -->
    <setting id="8021x_passthrough" value="0"/>
    <setting id="8021x_eapol_on_disconnect" value="0"/>
    <setting id="8021x_method" value=""/>
    <setting id="8021x_identity" value=""/>
    <setting id="8021x_anonymous_identity" value=""/>
    <setting id="8021x_password" value=""/>
    <setting id="8021x_client_cert" url="" value=""/>
    <setting id="8021x_client_key" url="" value=""/>
    <setting id="8021x_debug" value=""/>
    <setting id="network_default_enable_openvpn" value="0"/>
    <setting id="openvpn_logging" value="0"/>
    <setting id="openvpn_root_cert" url="" value=""/>
    <setting id="openvpn_client_cert" url="" value=""/>
    <setting id="openvpn_client_key" url="" value=""/>
    <setting id="openvpn_config_file" url="" value=""/>
    <setting id="openvpn_inline_config" url="" value="0"/>
    <setting id="openvpn_inline_config_ui" value=""/>

    <!-- Time -->
    <setting id="time_zone" value="America/Los_Angeles"/>
    <setting id="time_source" value="ntp"/>
    <setting id="ntp_server" value="pool.ntp.org"/>
    <setting id="ntp_resync" value="86400"/>
    <setting id="ntp_prefer_option42" value="1"/>

    <!-- SIP -->
    <setting id="accept_local_calls" value="any"/>
    <setting id="transport_udp_enabled" value="1"/>
    <setting id="transport_udp_port" value="5060"/>
    <setting id="transport_tcp_enabled" value="1"/>
    <setting id="transport_tcp_port" value="5060"/>
    <setting id="transport_tls_allowed" value="1"/>
    <setting id="transport_tls_port" value="5061"/>
    <setting id="tls_allow_wildcard_certs" value="1"/>
    <setting id="allow_insecure_ssl" value="0"/>
    <setting id="retransmit_until_response" value="0"/>
    <setting id="send_mac_with_useragent" value="0"/>
    <setting id="enable_check_sync" value="1"/>
    <setting id="enable_ice" value="0"/>
    <setting id="stunaddr" value=""/>
    <setting id="default_dial_plan" value="[0-8]xx|911|9411|9611|9011xxx.T3|91xxxxxxxxxx|9[2-9]xxxxxx|*xxx.T3|+xxxxxxxxxxxxxxx"/>
    <setting id="g729_authorized" value="0"/>

    <!-- Provisioning and PBX integration -->
    <setting id="in_switchvox_environment" value="0"/>
    <setting id="handshake_timeout" value="86400"/>
    <setting id="parking_lot_extension" value=""/>
    <setting id="parking_lot_enable_blind_transfer" value="0"/>
    <setting id="contacts_max_subscriptions" value="40"/>
    <setting id="contacts_merged_list_path" value="/nvdata/contact_lists/serialized_contacts.xml"/>
    <setting id="default_blf_items_autofill_dataset" value="blf_items_auto_fill"/>
    <setting id="enable_blf_on_unused_line_keys" value="1"/>
    <setting id="blf_page_return_timeout" value="0"/>
    <setting id="desi_strip_max_pages" value="0"/>
    <setting id="expansion_enable" value="0" type="EXP100"/>

    <!-- Access -->
    <setting id="web_ui_enabled" value="1"/>
    <setting id="login_password" value="789"/>
    <setting id="allow_app_dev" value="0"/>
    <setting id="log_level" value="information"/>
    <setting id="log_port" value="514"/>

    <!-- Audio and calls -->
    <setting id="speaker_volume" value="5"/>
    <setting id="ringer_volume" value="5"/>
    <setting id="handset_volume" value="5"/>
    <setting id="headset_volume" value="5"/>
    <setting id="reset_call_volume" value="0"/>
    <setting id="lock_ringing_volume" value="0"/>
    <setting id="ring_headset_only" value="0"/>
    <setting id="headset_answer" value="0"/>
    <setting id="call_waiting_tone" value="1"/>
    <setting id="ehs" value="auto"/>
    <setting id="hide_completed_elsewhere" value="0"/>
    <setting id="display_mc_notification" value="1"/>
    <setting id="display_mc_notifications" value="1"/>
    <setting id="use_call_photos" value="0" url=""/>
    <setting id="default_ringtone" value="Classic" conflict="freeze"/>

    <!-- Display -->
    <setting id="brightness" value="5"/>
    <setting id="contrast" value="0"/>
    <setting id="backlight_timeout" value="60"/>
    <setting id="dim_backlight" value="1"/>
    <setting id="small_clock" value="0"/>
    <setting id="name_format" value="first_last"/>
    <setting id="use_secure_labels" value="1"/>

    <!-- Locale: English only for now. -->
    <setting id="locale" value="en_US"/>
    <locales>
        <locale id="en_US" conflict="freeze">
            <setting id="time_short_format" value="h:mm a"/>
            <setting id="date_short_format" value="M/d/yy"/>
            <setting id="date_time_format" value="{1}, {0}"/>
            <setting id="idle_screen_clock_format" value="{0} EEE, MMM d"/>
            <setting id="tone_country" value="us"/>
            <setting id="translations" value="en_US"/>
        </locale>
    </locales>

    <!-- Open DPhone settings (stock ignores these). -->
    <setting id="open_ssh_enabled" value="0"/>
    <setting id="open_allow_provisioned_firmware" value="0"/>
    <setting id="open_dev_mode" value="0"/>
    <setting id="open_https_enabled" value="1"/>

    <codecs>
        <codec id="PCMU" priority="255" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="1"/>
        <codec id="PCMA" priority="13" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="1"/>
        <codec id="G722" priority="11" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="1"/>
        <codec id="G7221" priority="10" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="0" samplerate="uwb" bitrate="48000"/>
        <codec id="G726-32" priority="7" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="1"/>
        <codec id="opus" priority="6" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="0" complexity="10" pkt_loss="5" samplerate="wb" use_vbr="1"/>
        <codec id="G729" priority="5" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="1"/>
        <codec id="iLBC" priority="4" packetization="30" jitter_min="0" jitter_max="0" jitter_target="0" enabled="0"/>
        <codec id="L16" priority="2" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="0"/>
        <codec id="L16-256" priority="1" packetization="20" jitter_min="0" jitter_max="0" jitter_target="0" enabled="0"/>
    </codecs>

    <ringtones>
        <tones>
            <tone id="Classic" display="Classic" type="phone"/>
            <tone id="Chime" display="Chime" type="phone"/>
            <tone id="Soft" display="Soft" type="phone"/>
        </tones>
    </ringtones>

    <!-- Lamp behavior per line state: color green/red/amber, state off/on/slow/fast. -->
    <activity_indicator>
        <setting id="idle" color="amber" state="off"/>
        <setting id="default" color="amber" state="off"/>
        <setting id="hold" color="red" state="slow"/>
        <setting id="ringing" color="green" state="fast"/>
        <setting id="active" color="green" state="on"/>
        <setting id="new_vm" color="red" state="slow"/>
        <setting id="listen_vm" color="red" state="on"/>
        <setting id="leaving_vm" color="amber" state="slow"/>
        <setting id="screen_vm" color="amber" state="on"/>
        <setting id="announcement" color="amber" state="fast"/>
    </activity_indicator>

    <events>
        <event id="digium.incomingCall.voicemail" action="app"/>
    </events>

    <appconfig id="contacts">
        <auto_start/>
    </appconfig>
    <appconfig id="appscreen" conflict="replace">
        <application id="contacts"/>
        <application id="call_log"/>
        <application id="forward_calls"/>
        <application id="logoff"/>
        <auto_start/>
    </appconfig>
    <appconfig id="phonemenu">
        <auto_start/>
    </appconfig>

    <!-- Present and empty so a removed listener list clears the old one. -->
    <multicastpage/>

    <keymap>
        <state id="idle" conflict="replace">
            <softkeys>
                <key id="0" action="missed_or_call_log"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="status"/>
                <key id="3" action="info"/>
                <key id="4" action="forward_calls" label1="_FORWARD"/>
                <key id="5" action="menu"/>
            </softkeys>
        </state>
        <state id="hold" conflict="replace">
            <softkeys>
                <key id="0" action="resume"/>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="hold/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="resume"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="hold/conference" conflict="replace">
            <softkeys>
                <key id="0" action="resume"/>
                <key id="1" action="split_conference"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="hold/preconference" conflict="replace">
            <softkeys>
                <key id="0" action="resume"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="incoming" conflict="replace">
            <softkeys>
                <key id="0" action="accept_call"/>
                <key id="1" action="reject_call"/>
                <key id="2" action="transfer_call"/>
            </softkeys>
        </state>
        <state id="incoming/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="connected" conflict="replace">
            <softkeys>
                <key id="0" action="conference"/>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="connected/conference" conflict="replace">
            <softkeys>
                <key id="0" action="none"/>
                <key id="1" action="split_conference"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="connected/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="transfer_call"/>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
        <state id="dial" conflict="replace">
            <softkeys>
                <key id="0" action="toggle_url_number"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="dial/conference" conflict="replace">
            <softkeys>
                <key id="0" action="none"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="dial/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="none"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="dialing" conflict="replace">
            <softkeys>
                <key id="0" action="make_call"/>
                <key id="1" action="backspace"/>
                <key id="2" action="none"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="dialing/conference" conflict="replace">
            <softkeys>
                <key id="0" action="make_call"/>
                <key id="1" action="show_application" label1="_CONTACTS"><arg>contacts</arg></key>
                <key id="2" action="backspace"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="dialing/transfer" conflict="replace">
            <softkeys>
                <key id="0" action="transfer_call"/>
                <key id="1" action="make_call"/>
                <key id="2" action="backspace"/>
                <key id="3" action="cancel_call"/>
            </softkeys>
        </state>
        <state id="failed" conflict="replace">
            <softkeys>
                <key id="0" action="none"/>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="clear_call"/>
            </softkeys>
        </state>
        <state id="calling" conflict="replace">
            <softkeys>
                <key id="0" action="none"/>
                <key id="1" action="none"/>
                <key id="2" action="none"/>
                <key id="3" action="end_call"/>
            </softkeys>
        </state>
    </keymap>
</config>
